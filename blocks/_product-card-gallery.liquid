

{% assign product = closest.product %}
{% assign block_settings = block.settings %}

{% liquid
  # Automatic, tag-based badge detection (falls back to the manual override below
  # for merchants who haven't tagged their catalog yet). Priority order when a
  # product carries more than one badge tag: new > bestseller > trending > limited-edition.
  
  assign auto_badge_key = null
  if product.tags contains 'New'
    assign auto_badge_key = 'New'
  elsif product.tags contains 'bestseller'
    assign auto_badge_key = 'Best Seller'
  elsif product.tags contains 'trending'
    assign auto_badge_key = 'Trending'
  elsif product.tags contains 'limited-edition'
    assign auto_badge_key = 'Limited Edition'
  endif
  assign badge_key = auto_badge_key
  if badge_key == null and block_settings.custom_badge_text != 'none'
    assign badge_key = block_settings.custom_badge_text
  endif
%}
<span class="productBadch-{{badge_key }}">{{ badge_key }}</span>
{% capture children %}
  {% unless product == blank %}
    <div
      class="product-badges product-badges--{{ settings.badge_position }}"
      style="
        --badge-border-radius: {{ settings.badge_corner_radius }}px;
        --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
      "
    >
      {%- if product.available == false or product.compare_at_price > product.price -%}
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-{{ settings.badge_sold_out_color_scheme }}{% elsif product.compare_at_price > product.price %} color-{{ settings.badge_sale_color_scheme }}{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif product.compare_at_price > product.price -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
      {%- elsif badge_key -%}
        <div
          class="product-badges__badge product-badges__badge--rectangle product-badges__badge--custom-{{ badge_key }} color-{{ settings.badge_new_color_scheme }}"
        >
          {%- case badge_key -%}
            {%- when 'New' -%}
              {{ 'content.product_badge_new' | t }}
            {%- when 'trending' -%}
              {{ 'content.product_badge_trending' | t }}
            {%- when 'bestseller' -%}
              {{ 'content.product_badge_bestseller' | t }}
            {%- when 'limited_edition' -%}
              {{ 'content.product_badge_limited_edition' | t }}
          {%- endcase -%}
        </div>
      {%- endif -%}
    </div>
    {% if block_settings.show_wishlist_icon %}
      {% render 'wishlist-button', product: product %}
    {% endif %}
    {% if settings.enable_quick_view %}
      {% render 'quick-view-button', product: product %}
    {% endif %}
    {%  if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children, product: product %}

{% # Title and price for the zoomed out grid view %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "Badge & wishlist"
    },
    {
      "type": "select",
      "id": "custom_badge_text",
      "label": "Manual badge override",
      "info": "Shown only when the product isn't sold out or on sale, and has none of the automatic badge tags (new, bestseller, trending, limited-edition).",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "new",
          "label": "New"
        },
        {
          "value": "trending",
          "label": "Trending"
        },
        {
          "value": "bestseller",
          "label": "Best Seller"
        },
        {
          "value": "limited_edition",
          "label": "Limited Edition"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_icon",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
