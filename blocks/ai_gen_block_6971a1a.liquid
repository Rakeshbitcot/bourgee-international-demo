{% doc %}
  @prompt
    I need a section that one men category and second block category women i need select options to select categories and shop now button with category title i did not required and slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-category-showcase__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
  }

  .ai-category-showcase__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-showcase__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-category-showcase__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-category-showcase__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-showcase__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-category-showcase__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-showcase__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-category-showcase__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-category-showcase__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-category-showcase__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-category-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-showcase__container-{{ ai_gen_id }}">
    <div class="ai-category-showcase__item-{{ ai_gen_id }}">
      <div class="ai-category-showcase__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.men_collection.featured_image %}
          <img
            src="{{ block.settings.men_collection.featured_image | image_url: width: 800 }}"
            alt="{{ block.settings.men_collection.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.men_collection.featured_image.width }}"
            height="{{ block.settings.men_collection.featured_image.height }}"
            class="ai-category-showcase__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-category-showcase__image-placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% if block.settings.men_collection == blank %}
              <div class="ai-category-showcase__empty-state-{{ ai_gen_id }}">
                Select a men's collection
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
      <div class="ai-category-showcase__content-{{ ai_gen_id }}">
        {% if block.settings.men_collection %}
          <a
            href="{{ block.settings.men_collection.url }}"
            class="ai-category-showcase__button-{{ ai_gen_id }}"
          >
            {{ block.settings.men_button_text }}
          </a>
        {% else %}
          <span class="ai-category-showcase__button-{{ ai_gen_id }}">
            {{ block.settings.men_button_text }}
          </span>
        {% endif %}
      </div>
    </div>

    <div class="ai-category-showcase__item-{{ ai_gen_id }}">
      <div class="ai-category-showcase__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.women_collection.featured_image %}
          <img
            src="{{ block.settings.women_collection.featured_image | image_url: width: 800 }}"
            alt="{{ block.settings.women_collection.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.women_collection.featured_image.width }}"
            height="{{ block.settings.women_collection.featured_image.height }}"
            class="ai-category-showcase__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-category-showcase__image-placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% if block.settings.women_collection == blank %}
              <div class="ai-category-showcase__empty-state-{{ ai_gen_id }}">
                Select a women's collection
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
      <div class="ai-category-showcase__content-{{ ai_gen_id }}">
        {% if block.settings.women_collection %}
          <a
            href="{{ block.settings.women_collection.url }}"
            class="ai-category-showcase__button-{{ ai_gen_id }}"
          >
            {{ block.settings.women_button_text }}
          </a>
        {% else %}
          <span class="ai-category-showcase__button-{{ ai_gen_id }}">
            {{ block.settings.women_button_text }}
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category showcase",
  "settings": [
    {
      "type": "header",
      "content": "Men's category"
    },
    {
      "type": "collection",
      "id": "men_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "men_button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Women's category"
    },
    {
      "type": "collection",
      "id": "women_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "women_button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between categories",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap on mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Category showcase"
    }
  ]
}
{% endschema %}
