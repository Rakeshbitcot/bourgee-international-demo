                  {{ 'collection-2' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-category-carousel__overlay-{{ ai_gen_id }}">
              <h3 class="ai-category-carousel__title-{{ ai_gen_id }}">
                {% if block.settings.collection_2_title != blank %}
