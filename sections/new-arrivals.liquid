{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "womens_label",
      "label": "Women's Label",
      "default": "Shop Women"
    },
    {
      "type": "url",
      "id": "womens_url",
      "label": "Women's Link"
    },
    {
      "type": "text",
      "id": "mens_label",
      "label": "Men's Label",
      "default": "Shop Men"
    },
    {
      "type": "url",
      "id": "mens_url",
      "label": "Men's Link"
    },
    {
      "type": "header",
      "content": "Cards Per Row"
    },
    {
      "type": "range",
      "id": "desktop_cards",
      "label": "Desktop Cards",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_cards",
      "label": "Tablet Cards",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_cards",
      "label": "Mobile Cards",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "wrapper_gap",
      "label": "Left Panel & Slider Gap",
