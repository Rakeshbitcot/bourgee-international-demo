{% comment %}
NEW ARRIVALS — UPDATED WITH RECOMMENDED-STYLE CART FUNCTIONALITY
Updates:
✔ Hover size selector on product image (same as before)
✔ Async/await addToCart (Recommended section jaisa)
✔ Cart drawer refresh (Horizon theme compatible)
✔ Cart toggle/drawer me bhi add hota hai
✔ Modal popup same layout
✔ "Added to Bag" notification same
✔ Layout bilkul same rakha hai
✔ Image crop fix — contain + equal heights
{% endcomment %}

<section id="na-{{ section.id }}" class="na-section">

<div class="na-container">
<div class="na-wrapper">

  <!-- LEFT PANEL -->
  <div class="na-left">
    <h2>{{ section.settings.heading }}</h2>

    {% if section.settings.womens_label != blank %}
      <a href="{{ section.settings.womens_url }}" class="na-btn">
        {{ section.settings.womens_label }}
      </a>
    {% endif %}

    {% if section.settings.mens_label != blank %}
      <a href="{{ section.settings.mens_url }}" class="na-btn">
        {{ section.settings.mens_label }}
      </a>
    {% endif %}
  </div>


  <!-- RIGHT SLIDER -->
  <div class="na-right">

    <button class="na-arrow prev">&#8249;</button>

    <div class="na-slider">
      <div class="na-track">

        {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product %}

        <div class="na-card">

          <a href="{{ product.url }}" class="na-image-wrapper">
            <span class="na-badge">New</span>
            <div class="na-image">
              {{ product.featured_image
                | image_url: width: 800
                | image_tag: loading:'lazy'
              }}
            </div>
          </a>

          <div class="na-info">
            <p class="na-title">{{ product.title }}</p>
            <p class="na-price">{{ product.price | money }}</p>
          </div>

        </div>

        {% endif %}
        {% endfor %}

      </div>
    </div>

    <button class="na-arrow next">&#8250;</button>

  </div>

</div>

<!-- MODAL POPUP -->
<div id="na-modal-{{ section.id }}" class="na-modal">
  <div class="na-modal-content">
    <span class="na-modal-close">&times;</span>

    <div class="na-modal-body">
      <div class="na-modal-image">
        <img id="modal-product-image-{{ section.id }}" src="" alt="Product" height="auto" width="auto">
      </div>

      <div class="na-modal-info">
        <h2 id="modal-product-title-{{ section.id }}"></h2>

        <div class="na-modal-message">
          <p class="na-added-message" id="na-added-msg-{{ section.id }}">✓ Added to Bag</p>
        </div>

        <div id="modal-product-details-{{ section.id }}"></div>

        <div class="na-modal-price">
          <p id="modal-product-price-{{ section.id }}"></p>
        </div>

        <div class="na-modal-buttons">
          <button class="na-modal-btn primary" onclick="naGoToCheckout()">View Bag &amp; Checkout</button>
          <button class="na-modal-btn secondary" onclick="naCloseModal('{{ section.id }}')">Continue Shopping</button>
        </div>

        <div class="na-more-to-love">
          <h3>More to Love</h3>
          <div id="more-to-love-slider-{{ section.id }}" class="na-more-love-container">
            <!-- Will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

</section>


<style>

#na-{{ section.id }}{
  --gap: {{ section.settings.card_gap }}px;
  --desktop: {{ section.settings.desktop_cards }};
  --tablet: {{ section.settings.tablet_cards }};
  --mobile: {{ section.settings.mobile_cards }};
  --wrapper-gap: {{ section.settings.wrapper_gap }}px;
}

/* SECTION */
#na-{{ section.id }}{
  overflow: hidden;
  padding: 60px 0;
}

.na-container{
  width: 100%;
  max-width: 100%;
}

.na-wrapper{
  display: flex;
  gap: var(--wrapper-gap);
}

/* LEFT */
.na-left{
  width: 260px;
  padding-left: 40px;
}

.na-left h2{
  font-size: 28px;
  margin-bottom: 20px;
}

.na-btn{
  display: block;
  margin-bottom: 10px;
  padding: 14px;
  border: 1px solid #111;
  text-align: center;
  text-decoration: none;
  color: #111;
  transition: all 0.3s ease;
}

.na-btn:hover{
  background: #111;
  color: #fff;
}

/* RIGHT */
.na-right{
  flex: 1;
  position: relative;
  overflow: hidden;
}

/* SLIDER */
.na-slider{
  overflow: hidden;
}

.na-track{
  display: flex;
  gap: var(--gap);
  transition: transform .4s ease;
  align-items: flex-start;
}

/* CARD WIDTH CALCULATION */
.na-card{
  flex: 0 0 calc((100% / var(--desktop)) - var(--gap));
  cursor: pointer;
}
.na-card {
    padding: 20px 15px;
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    margin: 20px -10px 20px 10px;
    border-radius: 10px;
}

/* IMAGE WRAPPER */
.na-image-wrapper{
  position: relative;
  display: block;
  text-decoration: none;
  color: inherit;
}

/* NEW BADGE */
.na-badge{
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  background: #e8c547;
  color: #111;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 2px;
}

/* IMAGE */
.na-image{
  overflow: hidden;
}

.na-image img{
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  object-position: center center;
  transition: transform 0.5s ease;
}

.na-image-wrapper:hover .na-image img{
  transform: scale(1.08);
}

/* SIZE OVERLAY */
.na-size-overlay{
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  padding: 15px;
  min-height: 60px;
  pointer-events: none;
  background: rgba(255,255,255,0.95);
}

.na-image-wrapper:hover .na-size-overlay{
  opacity: 1;
  pointer-events: auto;
}

.na-size-selector{
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  max-width: 200px;
  pointer-events: auto;
}

.na-size-btn{
  padding: 8px 12px;
  background: #fff;
  border: 1px solid #ddd;
  cursor: pointer;
  font-size: 12px;
  font-weight: 500;
  transition: all 0.2s ease;
  border-radius: 2px;
  pointer-events: auto;
  position: relative;
  z-index: 10;
}

.na-size-btn:hover{
  background: #111;
  color: #fff;
  border-color: #111;
}

/* INFO */
.na-info{
  padding-top: 10px;
}

.na-title{
  font-size: 14px;
  margin: 0 0 5px 0;
  font-weight: 500;
}

.na-price{
  font-size: 14px;
  margin: 0;
  color: #666;
}

/* ARROWS */
.na-arrow{
  position: absolute;
  top: 45%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background: #fff;
  border: 1px solid #ddd;
  cursor: pointer;
  z-index: 5;
  font-size: 24px;
  transition: all 0.2s ease;
}

.na-arrow:hover{
  background: #111;
  color: #fff;
  border-color: #111;
}

.na-arrow.prev{ left: 0; }
.na-arrow.next{ right: 0; }

/* MODAL */
.na-modal{
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  animation: fadeIn 0.3s ease;
}

.na-modal.active{
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes fadeIn{
  from{ opacity: 0; }
  to{ opacity: 1; }
}

.na-modal-content{
  background: #fff;
  border-radius: 8px;
  width: 90%;
  max-width: 800px;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp{
  from{ transform: translateY(50px); opacity: 0; }
  to{ transform: translateY(0); opacity: 1; }
}

.na-modal-close{
  position: absolute;
  top: 15px;
  right: 20px;
  font-size: 28px;
  font-weight: bold;
  cursor: pointer;
  color: #999;
  z-index: 10;
  transition: color 0.2s ease;
}

.na-modal-close:hover{
  color: #111;
}

.na-modal-body{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  padding: 40px;
}

.na-modal-image{
  aspect-ratio: 3/4;
  overflow: hidden;
  border-radius: 4px;
}

.na-modal-image img{
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.na-modal-info h2{
  font-size: 24px;
  margin: 0 0 20px 0;
}

.na-modal-message{
  margin-bottom: 20px;
  padding: 15px;
  background: #f0f0f0;
  border-radius: 4px;
  text-align: center;
}

.na-added-message{
  margin: 0;
  font-size: 14px;
  color: #111;
  font-weight: 500;
}

#modal-product-details-{{ section.id }}{
  margin-bottom: 15px;
  font-size: 14px;
  color: #666;
}

.na-modal-price{
  margin-bottom: 25px;
}

.na-modal-price p{
  margin: 0;
  font-size: 18px;
  font-weight: bold;
  color: #111;
}

.na-modal-buttons{
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 30px;
}

.na-modal-btn{
  padding: 14px;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
}

.na-modal-btn.primary{
  background: #111;
  color: #fff;
}

.na-modal-btn.primary:hover{
  background: #333;
}

.na-modal-btn.secondary{
  background: #f0f0f0;
  color: #111;
  text-decoration: underline;
  border: none;
}

.na-modal-btn.secondary:hover{
  background: #e0e0e0;
}

.na-more-to-love h3{
  font-size: 16px;
  margin: 0 0 15px 0;
  font-weight: 600;
}

.na-more-love-container{
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.na-more-love-item{
  text-align: center;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.na-more-love-item:hover{
  opacity: 0.8;
}

.na-more-love-item img{
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  border-radius: 4px;
  margin-bottom: 8px;
}

.na-more-love-item p{
  font-size: 12px;
  margin: 5px 0;
}

.na-more-love-title{
  font-weight: 500;
  color: #111;
}

.na-more-love-price{
  color: #666;
}

/* TABLET */
@media(max-width: 990px){
  .na-wrapper{
    flex-direction: column;
    gap:20px;
  }

  .na-left{
    width: 100%;
    padding-left: 20px;
  }

  .na-card{
    flex: 0 0 calc((100% / var(--tablet)) - var(--gap));
  }

  .na-modal-body{
    grid-template-columns: 1fr;
    padding: 20px;
  }

  .na-more-love-container{
    grid-template-columns: repeat(2, 1fr);
  }
}

/* MOBILE */
@media(max-width: 600px){
  .na-card{
    flex: 0 0 calc((100% / var(--mobile)) - var(--gap));
  }

  .na-modal-content{
    width: 95%;
    border-radius: 0;
  }

  .na-modal-body{
    padding: 15px;
    gap: 15px;
  }

  .na-modal-info h2{
    font-size: 18px;
  }

  .na-more-love-container{
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
}

</style>


<script>
(function(){

  const section = document.querySelector('#na-{{ section.id }}');
  if (!section) return;

  const track = section.querySelector('.na-track');
  const modal = document.getElementById('na-modal-{{ section.id }}');
  let index = 0;

  // SLIDER FUNCTIONALITY
  function move(){
    const card = track.querySelector('.na-card');
    if (!card) return;
    const gap = parseInt(getComputedStyle(track).gap);
    const moveX = (card.offsetWidth + gap) * index;
    track.style.transform = `translateX(-${moveX}px)`;
  }

  section.querySelector('.next').onclick = () => {
    index++;
    if (index >= track.children.length) index = 0;
    move();
  };

  section.querySelector('.prev').onclick = () => {
    index--;
    if (index < 0) index = track.children.length - 1;
    move();
  };

  // MODAL CLOSE
  section.querySelector('.na-modal-close').onclick = () => {
    modal.classList.remove('active');
  };

  modal.onclick = (e) => {
    if (e.target === modal) modal.classList.remove('active');
  };

  // EQUAL HEIGHTS — sabhi cards ki image height barabar karo
  function naEqualizeHeights() {
    const images = section.querySelectorAll('.na-image');
    let maxH = 0;
    images.forEach(img => {
      img.style.height = 'auto';
      maxH = Math.max(maxH, img.offsetHeight);
    });
    images.forEach(img => {
      img.style.height = maxH + 'px';
    });
  }

  // Images load hone ka wait karo phir equalize karo
  window.addEventListener('load', naEqualizeHeights);
  window.addEventListener('resize', naEqualizeHeights);
  setTimeout(naEqualizeHeights, 500);

})();

/* ==================== CART REFRESH (Horizon Theme Compatible) ==================== */
async function naRefreshCart() {
  try {
    const cartRes = await fetch('/cart.js');
    const cart = await cartRes.json();

    try {
      const { CartUpdateEvent } = await import('@theme/events');
      const event = new CartUpdateEvent(cart, 'na-add-to-cart', {
        itemCount: cart.item_count,
        source: 'new-arrivals-section'
      });
      document.dispatchEvent(event);
    } catch(e) {
      // Fallback to section rendering
    }

    try {
      const sectionsRes = await fetch('/?sections=cart-drawer,cart-icon-bubble,header');
      const sections = await sectionsRes.json();

      const drawerSelectors = [
        'cart-drawer-component',
        'cart-drawer',
        '[data-cart-drawer]',
        '.cart-drawer'
      ];
      for (let sel of drawerSelectors) {
        const drawer = document.querySelector(sel);
        if (drawer && sections['cart-drawer']) {
          drawer.outerHTML = sections['cart-drawer'];
          break;
        }
      }

      if (sections['cart-icon-bubble']) {
        document.querySelectorAll('.cart-icon, [data-cart-icon], .header__cart, .cart-bubble').forEach(el => {
          el.outerHTML = sections['cart-icon-bubble'];
        });
      }
    } catch(sectionErr) {
      // Section rendering fallback
    }

    document.dispatchEvent(new CustomEvent('cart:refresh',  { bubbles: true, detail: cart }));
    document.dispatchEvent(new CustomEvent('cart:updated',  { bubbles: true, detail: cart }));
    document.dispatchEvent(new CustomEvent('cart:change',   { bubbles: true, detail: cart }));
    document.dispatchEvent(new CustomEvent('theme:cart:change', { bubbles: true, detail: { cart } }));

    return cart;

  } catch (err) {
    console.error('NA Cart refresh failed:', err);
  }
}

/* ==================== ADD TO CART ==================== */
async function naAddToCart(e, variantId, size, title, image, price) {
  e.preventDefault();
  e.stopPropagation();

  const clickedBtn      = e.target;
  const closestSection  = clickedBtn.closest('.na-section');

  let modal   = null;
  let msgEl   = null;
  let imgEl   = null;
  let titleEl = null;
  let detEl   = null;
  let priceEl = null;

  if (closestSection) {
    modal   = closestSection.querySelector('.na-modal');
    msgEl   = closestSection.querySelector('.na-added-message');
    imgEl   = closestSection.querySelector('[id^="modal-product-image-"]');
    titleEl = closestSection.querySelector('[id^="modal-product-title-"]');
    detEl   = closestSection.querySelector('[id^="modal-product-details-"]');
    priceEl = closestSection.querySelector('[id^="modal-product-price-"]');
  }

  if (!modal) return;

  imgEl.src            = image;
  titleEl.textContent  = title;
  detEl.textContent    = 'Size: ' + size;
  priceEl.textContent  = new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR'
  }).format(price / 100);

  msgEl.textContent = 'Adding to Bag…';
  msgEl.style.color = '#888';
  modal.classList.add('active');

  try {
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({
        items: [{ id: parseInt(variantId), quantity: 1 }]
      })
    });

    if (!response.ok) {
      const errData = await response.json();
      throw new Error(errData.description || 'Add to cart failed');
    }

    msgEl.textContent = '✓ Added to Bag';
    msgEl.style.color = '#111';

    await new Promise(resolve => setTimeout(resolve, 300));
    await naRefreshCart();

  } catch (err) {
    console.error('NA Add to Cart Error:', err);
    msgEl.textContent = '⚠ Failed — Try again';
    msgEl.style.color = '#c00';
  }
}

/* ==================== MODAL HELPERS ==================== */
function naCloseModal(sectionId) {
  const modal = document.getElementById('na-modal-' + sectionId);
  if (modal) modal.classList.remove('active');
}

function naGoToCheckout() {
  window.location.href = '/cart';
}

document.addEventListener('DOMContentLoaded', naRefreshCart);
</script>


