{%- doc -%}
  Renders a "Frequently bought together" widget on the product page: the product
  being viewed plus merchant-selected companion products (added via blocks), each
  with a checkbox, and a single button that adds every checked item to the cart
  in one request.
{%- enddoc -%}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
%}

<script
  src="{{ 'frequently-bought-together.js' | asset_url }}"
  type="module"
></script>

<frequently-bought-together
  class="frequently-bought-together color-{{ section.settings.color_scheme }}"
  data-testid="frequently-bought-together"
  data-money-format="{{ shop.money_format | strip_html }}"
  data-currency="{{ cart.currency.iso_code }}"
  {{ section.shopify_attributes }}
>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      color-{{ section.settings.color_scheme }}
      spacing-style
      gap-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% render 'gap-style', value: section.settings.gap %}
    "
  >
    {% if section.settings.heading != blank %}
      <h2 class="fbt-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if current_variant != blank %}
      <div class="fbt-layout">
        <div class="fbt-items">
          <div
            class="fbt-item fbt-item--current"
            data-testid="fbt-item-current"
          >
            <label class="fbt-item__checkbox">
              <input
                type="checkbox"
                checked
                disabled
                data-variant-id="{{ current_variant.id }}"
                data-price="{{ current_variant.price }}"
                aria-label="{{ 'accessibility.include_product_in_bundle' | t: product: product.title }}"
              >
            </label>
            <a
              href="{{ product.url }}"
              class="fbt-item__media"
              tabindex="-1"
            >
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', widths: '80,160,240', alt: product.featured_image.alt
                }}
              {%- endif -%}
            </a>
            <div class="fbt-item__info">
              <p class="fbt-item__title">{{ product.title }}</p>
              {% render 'price', product_resource: product %}
            </div>
          </div>

          {% content_for 'blocks' %}
        </div>

        <div class="fbt-summary">
          <p class="fbt-summary__total">
            {{ 'content.total_price' | t }}
            <span ref="totalPrice"></span>
          </p>
          <button
            type="button"
            class="button"
            ref="addButton"
            on:click="/addSelectedToCart"
            data-testid="fbt-add-button"
          >
            {{ section.settings.button_label }}
          </button>
          <div
            class="visually-hidden"
            role="status"
            aria-live="polite"
            ref="liveRegion"
          ></div>
        </div>
      </div>
    {% endif %}
  </div>
</frequently-bought-together>

{% stylesheet %}
  .fbt-heading {
    margin-block-end: var(--margin-md, 16px);
  }

  .fbt-layout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-lg, 24px);
    align-items: flex-start;
  }

  .fbt-items {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 12px);
    flex: 1 1 320px;
  }

  .fbt-item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 12px);
  }

  .fbt-item__checkbox input {
    inline-size: 20px;
    block-size: 20px;
  }

  .fbt-item__media {
    display: block;
    inline-size: 64px;
    block-size: 64px;
    flex-shrink: 0;
  }

  .fbt-item__media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    border-radius: var(--style-border-radius, 4px);
  }

  .fbt-item__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fbt-item__title {
    text-decoration: none;
    color: inherit;
  }

  .fbt-summary {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 8px);
    flex: 0 0 220px;
    padding: var(--padding-md, 16px);
    border: var(--style-border-width, 1px) solid var(--color-border);
    border-radius: var(--style-border-radius, 4px);
  }

  .fbt-summary__total {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.frequently_bought_together",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "_fbt-product"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.frequently_bought_together"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.add_selected_to_cart"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.frequently_bought_together",
      "category": "t:categories.products",
      "settings": {
        "heading": "Frequently bought together",
        "button_label": "Add selected to cart",
        "section_width": "page-width",
        "gap": 12,
        "color_scheme": "scheme-1",
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": {
        "fbt-product-1": {
          "type": "_fbt-product"
        }
      },
      "block_order": ["fbt-product-1"]
    }
  ]
}
{% endschema %}
