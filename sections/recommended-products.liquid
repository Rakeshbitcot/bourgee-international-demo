{% comment %}
RECOMMENDED FOR YOU — With Add To Cart Popup (like New Arrivals)
- Tall 3:4 images, object-fit cover
- Hover: second image fades in smoothly
- Hover: size bar slides up from bottom
- Size click: opens modal popup (no page navigation)
- Image click: goes to product page (normal)
{% endcomment %}

<section class="bourgee-recommended">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="bourgee-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="swiper bourgeeSwiper-{{ section.id }}">
      <div class="swiper-wrapper">

        {% if section.blocks.size > 0 %}

          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {% if product != blank %}
              <div class="swiper-slide">
                <div class="bourgee-card">

                  <!-- IMAGE WRAPPER — click goes to product page -->
                  <a href="{{ product.url }}" class="bourgee-image-wrapper">
                    <div class="bourgee-image-box">

                      <img
                        src="{{ product.featured_image | image_url: width: 900 }}"
                        class="primary-image"
                        loading="lazy"
                        alt="{{ product.title | escape }}"
                        width="900"
                        height="1200">

                      {% if product.images.size > 1 %}
                        <img
                          src="{{ product.images[1] | image_url: width: 900 }}"
                          class="hover-image"
                          loading="lazy"
                          alt="{{ product.title | escape }}"
                          width="900"
                          height="1200">
                      {% endif %}

                    </div>

                    <!-- SIZE BAR -->
                    {% assign shown_sizes = '' %}
                    <div class="bourgee-sizes">
                      {% for variant in product.variants %}
                        {% if variant.available %}
                          {% unless shown_sizes contains variant.option1 %}
                            <button
                              type="button"
                              class="size-item"
                              onclick="bourgeeAddToCart(event, '{{ variant.id }}', '{{ variant.option1 | escape }}', '{{ product.title | escape }}', '{{ product.featured_image | image_url: width: 600 }}', {{ variant.price }})">
                              {{ variant.option1 }}
                            </button>
                            {% assign shown_sizes = shown_sizes | append: variant.option1 | append: ',' %}
                          {% endunless %}
                        {% endif %}
                      {% endfor %}
                    </div>

                  </a>

                  <div class="bourgee-info">
                    <p class="bourgee-title">{{ product.title }}</p>
                    <p class="bourgee-price">{{ product.price | money }}</p>
                  </div>

                </div>
              </div>
            {% endif %}
          {% endfor %}

        {% else %}

          {% assign auto_products = collections[section.settings.collection].products %}
          {% for product in auto_products limit: section.settings.limit %}
            <div class="swiper-slide">
              <div class="bourgee-card">

                <a href="{{ product.url }}" class="bourgee-image-wrapper">
                  <div class="bourgee-image-box">

                    <img
                      src="{{ product.featured_image | image_url: width: 900 }}"
                      class="primary-image"
                      loading="lazy"
                      alt="{{ product.title | escape }}"
                      width="900"
                      height="1200">

                    {% if product.images.size > 1 %}
                      <img
                        src="{{ product.images[1] | image_url: width: 900 }}"
                        class="hover-image"
                        loading="lazy"
                        alt="{{ product.title | escape }}"
                        width="900"
                        height="1200">
                    {% endif %}

                  </div>

                  <!-- SIZE BAR -->
                  {% assign shown_sizes = '' %}
                  <div class="bourgee-sizes">
                    {% for variant in product.variants %}
                      {% if variant.available %}
                        {% unless shown_sizes contains variant.option1 %}
                          <button
                            type="button"
                            class="size-item"
                            onclick="bourgeeAddToCart(event, '{{ variant.id }}', '{{ variant.option1 | escape }}', '{{ product.title | escape }}', '{{ product.featured_image | image_url: width: 600 }}', {{ variant.price }})">
                            {{ variant.option1 }}
                          </button>
                          {% assign shown_sizes = shown_sizes | append: variant.option1 | append: ',' %}
                        {% endunless %}
                      {% endif %}
                    {% endfor %}
                  </div>

                </a>

                <div class="bourgee-info">
                  <p class="bourgee-title">{{ product.title }}</p>
                  <p class="bourgee-price">{{ product.price | money }}</p>
                </div>

              </div>
            </div>
          {% endfor %}

        {% endif %}

      </div>

      <!-- PREV -->
      <div class="bourgee-nav-prev bourgee-prev-{{ section.id }}">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none">
          <path d="M9 1L1 9L9 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- NEXT -->
      <div class="bourgee-nav-next bourgee-next-{{ section.id }}">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none">
          <path d="M1 1L9 9L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

    </div>
  </div>
</section>


<!-- ===== MODAL POPUP ===== -->
<div id="bourgee-modal" class="bourgee-modal">
  <div class="bourgee-modal-content">
    <span class="bourgee-modal-close">&times;</span>

    <div class="bourgee-modal-body">
      <div class="bourgee-modal-image">
        <img id="bourgee-modal-img" src="" alt="Product" width="auto" height="auto">
      </div>

      <div class="bourgee-modal-info">
        <h2 id="bourgee-modal-title"></h2>

        <div class="bourgee-modal-message">
          <p class="bourgee-added-msg">✓ Added to Bag</p>
        </div>

        <div id="bourgee-modal-details"></div>

        <div class="bourgee-modal-price-wrap">
          <p id="bourgee-modal-price"></p>
        </div>

        <div class="bourgee-modal-btns">
          <button class="bourgee-mbtn primary" onclick="bourgeeGoCheckout()">View Bag &amp; Checkout</button>
          <button class="bourgee-mbtn secondary" onclick="bourgeeCloseModal()">Continue Shopping</button>
        </div>
      </div>
    </div>
  </div>
</div>


<style>

/* ===================== SECTION ===================== */
.bourgee-recommended {
  padding: 48px 0;
  overflow-x: hidden;
}
.bourgee-recommended .swiper-wrapper {
  padding: 0 40px;
}

.bourgee-heading {
  font-size: 24px;
  font-weight: 500;
  margin-bottom: 24px;
  letter-spacing: -0.2px;
  color: #111;
  padding: 0 38px;
}

.bourgeeSwiper-{{ section.id }} .swiper-slide {
  width: 280px;
}

@media (max-width: 768px) {
  .bourgeeSwiper-{{ section.id }} .swiper-slide {
    width: 68vw;
  }
}

/* ===================== CARD ===================== */
.bourgee-card {
  display: block;
  color: #111;
  text-decoration: none;
  padding: 22px 10px;
  box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
}

.bourgee-image-wrapper {
  display: block;
  position: relative;
  text-decoration: none;
}

.bourgee-image-box {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f0f0f0;
}

.bourgee-image-box .primary-image {
  position: relative;
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  object-position: center center;
  transition: opacity 0.4s ease, transform 0.5s ease;
  z-index: 1;
}

.bourgee-image-box .hover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center center;
  opacity: 0;
  transition: opacity 0.4s ease, transform 0.5s ease;
  z-index: 2;
}

.bourgee-image-wrapper:hover .primary-image {
  transform: scale(1.08);
}

.bourgee-image-wrapper:hover .hover-image {
  opacity: 1;
  transform: scale(1.08);
}
/* ===================== SIZE BAR ===================== */
.bourgee-sizes {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 3;
  background: rgb(255 255 255 / 0%);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  padding: 10px 12px;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  opacity:0;
  visibility:hidden;
  width: fit-content;
  margin: auto;
}

.bourgee-image-wrapper:hover .bourgee-sizes {
  transform: translate(0px, 20px);
  opacity:1;
  visibility:visible;
}

.size-item {
    font-size: 12px;
    font-weight: 400;
    color: #111;
    cursor: pointer;
    letter-spacing: 0.3px;
    transition: font-weight 0.15s;       
    font-family: inherit;
    position: relative;
    z-index: 10;
    pointer-events: auto;
    padding: 9px 11px;
    background: #293d33;
    color: #fff;
    border-radius: 20px;
    width: 30px;
    height: 30px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.size-item:hover {
  font-weight: 700;
}

/* ===================== INFO ===================== */
.bourgee-info {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.bourgee-title {
  font-size: 14px;
  font-weight: 500;
  color: #111;
  margin: 0;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bourgee-price {
  font-size: 14px;
  margin: 0;
  color: #666;
}

/* ===================== SWIPER NAV ===================== */
.bourgeeSwiper-{{ section.id }} {
  position: relative;
  overflow: visible;
}

.bourgee-nav-prev,
.bourgee-nav-next {
  position: absolute;
  top: 45%;
  transform: translateY(-50%);
  z-index: 20;
  width: 42px;
  height: 42px;
  background: #fff;
  border-radius: 10%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  cursor: pointer;
  transition: all .25s ease;
  color: #111;
}

.bourgee-nav-prev { left: 45px; }
.bourgee-nav-next { right: 5px; }

.bourgee-nav-prev:hover,
.bourgee-nav-next:hover {
  box-shadow: 0 4px 20px rgba(0,0,0,0.22);
  transform: translateY(-50%) scale(1.06);
}

@media (max-width: 768px) {
  .bourgee-nav-prev,
  .bourgee-nav-next { display: none; }
}

/* ===================== MODAL ===================== */
.bourgee-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  animation: bourgee-fadeIn 0.3s ease;
}

.bourgee-modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes bourgee-fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.bourgee-modal-content {
  background: #fff;
  border-radius: 8px;
  width: 90%;
  max-width: 800px;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  animation: bourgee-slideUp 0.3s ease;
}

@keyframes bourgee-slideUp {
  from { transform: translateY(50px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

.bourgee-modal-close {
  position: absolute;
  top: 15px;
  right: 20px;
  font-size: 28px;
  font-weight: bold;
  cursor: pointer;
  color: #999;
  z-index: 10;
  transition: color 0.2s ease;
  line-height: 1;
}

.bourgee-modal-close:hover { color: #111; }

.bourgee-modal-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  padding: 40px;
}

.bourgee-modal-image {
  aspect-ratio: 3/4;
  overflow: hidden;
  border-radius: 4px;
}

.bourgee-modal-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.bourgee-modal-info h2 {
  font-size: 24px;
  margin: 0 0 20px 0;
}

.bourgee-modal-message {
  margin-bottom: 20px;
  padding: 15px;
  background: #f0f0f0;
  border-radius: 4px;
  text-align: center;
}

.bourgee-added-msg {
  margin: 0;
  font-size: 14px;
  color: #111;
  font-weight: 500;
}

#bourgee-modal-details {
  margin-bottom: 15px;
  font-size: 14px;
  color: #666;
}

.bourgee-modal-price-wrap {
  margin-bottom: 25px;
}

.bourgee-modal-price-wrap p {
  margin: 0;
  font-size: 18px;
  font-weight: bold;
  color: #111;
}

.bourgee-modal-btns {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.bourgee-mbtn {
  padding: 14px;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
}

.bourgee-mbtn.primary {
  background: #111;
  color: #fff;
}

.bourgee-mbtn.primary:hover { background: #333; }

.bourgee-mbtn.secondary {
  background: #f0f0f0;
  color: #111;
  text-decoration: underline;
}

.bourgee-mbtn.secondary:hover { background: #e0e0e0; }

/* MODAL RESPONSIVE */
@media (max-width: 768px) {
  .bourgee-modal-body {
    grid-template-columns: 1fr;
    padding: 20px;
    gap: 15px;
  }

  .bourgee-modal-info h2 { font-size: 18px; }
}

</style>


<script>
document.addEventListener('DOMContentLoaded', function () {

  new Swiper('.bourgeeSwiper-{{ section.id }}', {
    slidesPerView: 'auto',
    spaceBetween: 16,
    loop: true,
    grabCursor: true,
    navigation: {
      prevEl: '.bourgee-prev-{{ section.id }}',
      nextEl: '.bourgee-next-{{ section.id }}'
    },
    breakpoints: {
      0:   { spaceBetween: 12 },
      768: { spaceBetween: 16 },
      990: { spaceBetween: 20 }
    }
  });

  const modal = document.getElementById('bourgee-modal');
  document.querySelector('.bourgee-modal-close').addEventListener('click', () => modal.classList.remove('active'));
  modal.addEventListener('click', e => {
    if (e.target === modal) modal.classList.remove('active');
  });
});

/* ==================== HORIZON THEME CART REFRESH ==================== */
async function bourgeeRefreshCart() {
  try {
    const cartRes = await fetch('/cart.js');
    const cart = await cartRes.json();

    try {
      const { CartUpdateEvent } = await import('@theme/events');
      const event = new CartUpdateEvent(cart, 'bourgee-add-to-cart', {
        itemCount: cart.item_count,
        source: 'recommended-section'
      });
      document.dispatchEvent(event);
    } catch(e) {
      // CartUpdateEvent not available, using fallback
    }

    const sectionsRes = await fetch(`/?sections=cart-drawer,cart-icon-bubble,header`);
    const sections = await sectionsRes.json();

    const drawerSelectors = ['cart-drawer-component', 'cart-drawer', '[data-cart-drawer]', '.cart-drawer'];

    for (let sel of drawerSelectors) {
      const drawer = document.querySelector(sel);
      if (drawer && sections['cart-drawer']) {
        drawer.outerHTML = sections['cart-drawer'];
        break;
      }
    }

    if (sections['cart-icon-bubble']) {
      document.querySelectorAll('.cart-icon, [data-cart-icon], .header__cart, .cart-bubble').forEach(el => {
        el.outerHTML = sections['cart-icon-bubble'];
      });
    }

    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: cart }));
    document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: cart }));

    return cart;

  } catch (err) {
    console.error('Cart refresh failed:', err);
  }
}

/* ==================== ADD TO CART ==================== */
async function bourgeeAddToCart(e, variantId, size, title, image, price) {
  e.preventDefault();
  e.stopPropagation();

  const modal    = document.getElementById('bourgee-modal');
  const imgEl    = document.getElementById('bourgee-modal-img');
  const titleEl  = document.getElementById('bourgee-modal-title');
  const detEl    = document.getElementById('bourgee-modal-details');
  const priceEl  = document.getElementById('bourgee-modal-price');
  const msgEl    = document.querySelector('.bourgee-added-msg');

  imgEl.src            = image;
  titleEl.textContent  = title;
  detEl.textContent    = 'Size: ' + size;
  priceEl.textContent  = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(price / 100);

  msgEl.textContent  = 'Adding to Bag…';
  msgEl.style.color  = '#888';
  modal.classList.add('active');

  try {
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
    });

    if (!response.ok) throw new Error('Add failed');

    msgEl.textContent = '✓ Added to Bag';
    msgEl.style.color = '#111';

    await new Promise(resolve => setTimeout(resolve, 300));
    await bourgeeRefreshCart();

  } catch (err) {
    console.error(err);
    msgEl.textContent = '⚠ Failed — Try again';
    msgEl.style.color = '#c00';
  }
}

function bourgeeCloseModal() {
  document.getElementById('bourgee-modal').classList.remove('active');
}

function bourgeeGoCheckout() {
  window.location.href = '/cart';
}

document.addEventListener('DOMContentLoaded', bourgeeRefreshCart);

function bourgeeEqualizeHeights() {
  const boxes = document.querySelectorAll('.bourgeeSwiper-{{ section.id }} .bourgee-image-box');
  let maxH = 0;
  boxes.forEach(b => {
    b.style.height = 'auto';
    maxH = Math.max(maxH, b.offsetHeight);
  });
  boxes.forEach(b => b.style.height = maxH + 'px');
}

document.addEventListener('DOMContentLoaded', () => {
  setTimeout(bourgeeEqualizeHeaders, 500); // images load hone ka wait
});
window.addEventListener('resize', bourgeeEqualizeHeights);
</script>


{% schema %}
{
  "name": "Recommended",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (auto mode)"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Products Limit"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Add Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "bourgee Recommended"
    }
  ]
}
{% endschema %}