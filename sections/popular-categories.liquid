{% stylesheet %}

.popular-categories{
padding:60px 0;
}

.popular-categories__title{
font-size:28px;
margin-bottom:20px;
}

.pc-tabs{
display:flex;
gap:20px;
margin-bottom:20px;
font-size:18px;
}

.pc-tab{
cursor:pointer;
font-weight:600;
opacity:.5;
}

.pc-tab.active{
opacity:1;
border-bottom:2px solid #000;
}

/* SWIPER */
.pc-slider{
position:relative;
}

.pc-card{
width:100%;
aspect-ratio:auto;
overflow:hidden;
border-radius:10px;
position:relative;
display:block;
}

.pc-card img{
width:100%;
height:100%;
object-fit:contain;
display:block;
}

.pc-overlay{
position:absolute;
bottom:-1px;
left:0;
right:0;
padding:10px 20px;
background:linear-gradient(to top, rgb(41 61 51), #293d33);
color:#fff;
font-size:18px;
}

/* ARROWS */
/* ARROW STYLE */

.pc-prev,
.pc-next{
width:38px;
height:38px;
background:#fff;
border-radius:50%;
box-shadow:0 4px 10px rgba(0,0,0,.12);
}

.pc-prev::after,
.pc-next::after{
font-size:14px;
font-weight:bold;
color:#000;
}

/* position little inside */
.pc-prev{
left:-10px;
}

.pc-next{
right:-10px;
}

/* hover effect */
.pc-prev:hover,
.pc-next:hover{
transform:scale(1.05);
}
svg.swiper-navigation-icon {
    width: 13px !important;  
    color: #000;
}
a.pc-card.swiper-slide {
        box-shadow: rgba(60, 64, 67, 0.3) 0px 1px 2px 0px, rgba(60, 64, 67, 0.15) 0px 1px 3px 1px;
    margin-top: 10px;
    margin-bottom: 10px;
}
@media (max-width: 768px) {
.popular-categories {
    padding: 30px 0;
}
.shopify-section .popular-categories h2.popular-categories__title, 
.shopify-section .popular-categories .pc-tabs {
    padding-left: 12px !important;
}
a.pc-card.swiper-slide {
    aspect-ratio: auto;
    box-shadow: rgba(50, 50, 93, 0.25) 0px 6px 12px -2px, rgba(0, 0, 0, 0.3) 0px 3px 7px -3px;
    margin: 20px auto;
    
}
}
{% endstylesheet %}



<div class="popular-categories page-width">

<h2 class="popular-categories__title">
{{ section.settings.title }}
</h2>

<div class="pc-tabs">
<span class="pc-tab active" data-tab="women">Women</span>
<span class="pc-tab" data-tab="men">Men</span>
</div>



<!-- WOMEN SLIDER -->
<div class="pc-slider swiper" id="women">

<div class="swiper-wrapper">

{% for block in section.blocks %}
{% if block.type == 'women' %}

<a href="{{ block.settings.link }}" class="pc-card swiper-slide">

<img src="{{ block.settings.image | image_url: width:600 }}" alt="{{ block.settings.title }}" height="auto" width="auto" >

<div class="pc-overlay">
{{ block.settings.title }}
</div>

</a>

{% endif %}
{% endfor %}

</div>

<div class="pc-prev swiper-button-prev"></div>
<div class="pc-next swiper-button-next"></div>

</div>



<!-- MEN SLIDER -->
<div class="pc-slider swiper" id="men" style="display:none;">

<div class="swiper-wrapper">

{% for block in section.blocks %}
{% if block.type == 'men' %}

<a href="{{ block.settings.link }}" class="pc-card swiper-slide">

<img src="{{ block.settings.image | image_url: width:600 }}" alt="{{ block.settings.title }}" height="auto" width="auto">

<div class="pc-overlay">
{{ block.settings.title }}
</div>

</a>

{% endif %}
{% endfor %}

</div>

<div class="pc-prev swiper-button-prev"></div>
<div class="pc-next swiper-button-next"></div>

</div>

</div>



<script>
document.addEventListener("DOMContentLoaded",function(){

/* TAB SWITCH */
document.querySelectorAll('.pc-tab').forEach(tab=>{
tab.addEventListener('click',()=>{

document.querySelectorAll('.pc-tab')
.forEach(t=>t.classList.remove('active'));

tab.classList.add('active');

document.getElementById('women').style.display='none';
document.getElementById('men').style.display='none';

document.getElementById(tab.dataset.tab).style.display='block';

});
});


/* SWIPER INIT */
document.querySelectorAll('.pc-slider').forEach(slider => {

  new Swiper(slider, {
    slidesPerView: 4,
    spaceBetween: 10,

    loop: true,
    speed: 700,
    grabCursor: true,

    navigation: {
      nextEl: slider.querySelector('.pc-next'),
      prevEl: slider.querySelector('.pc-prev')
    },

    breakpoints: {
      0: {
        slidesPerView: 1,
        centeredSlides: true,
        slidesOffsetBefore: 20,
        slidesOffsetAfter: 20
      },
      768: {
        slidesPerView: 1,
        centeredSlides: false
      },
      1024: {
        slidesPerView: 3
      }
    }

  });

});

});
</script>



{% schema %}
{
"name":"Popular Categories",
"settings":[
{
"type":"text",
"id":"title",
"label":"Heading",
"default":"Popular Categories"
}
],

"blocks":[
{
"type":"women",
"name":"Women Category",
"settings":[
{"type":"image_picker","id":"image","label":"Image"},
{"type":"text","id":"title","label":"Title"},
{"type":"url","id":"link","label":"Collection Link"}
]
},
{
"type":"men",
"name":"Men Category",
"settings":[
{"type":"image_picker","id":"image","label":"Image"},
{"type":"text","id":"title","label":"Title"},
{"type":"url","id":"link","label":"Collection Link"}
]
}
],

"max_blocks":20,

"presets":[
{"name":"Popular Categories"}
]
}
{% endschema %}