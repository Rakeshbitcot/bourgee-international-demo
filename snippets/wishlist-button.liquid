{%- doc -%}
  Renders a wishlist toggle button for a product card.
  State is stored client-side (localStorage) — no backend/app required.

  @param {object} product - The product object
{%- enddoc -%}

{% if product != blank %}
  <wishlist-button
    class="wishlist-button"
    data-product-handle="{{ product.handle }}"
    data-add-label="{{ 'content.wishlist_add' | t }}"
    data-remove-label="{{ 'content.wishlist_remove' | t }}"
  >
    <button
      type="button"
      class="wishlist-button__toggle"
      aria-pressed="false"
      aria-label="{{ 'content.wishlist_add' | t }}"
    >
      <svg
        class="wishlist-button__icon"
        aria-hidden="true"
        focusable="false"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 20 20"
      >
        <path
          class="wishlist-button__icon-outline"
          fill-rule="evenodd"
          d="M10 5.2393L8.5149 3.77392C6.79996 2.08174 4.01945 2.08174 2.30451 3.77392C0.589562 5.4661 0.589563 8.2097 2.30451 9.90188L10 17.4952L17.6955 9.90188C19.4104 8.2097 19.4104 5.4661 17.6955 3.77392C15.9805 2.08174 13.2 2.08174 11.4851 3.77392L10 5.2393ZM10.765 3.06343C12.8777 0.978857 16.3029 0.978856 18.4155 3.06343C20.5282 5.148 20.5282 8.52779 18.4155 10.6124L10.72 18.2057C10.3224 18.5981 9.67763 18.5981 9.27996 18.2057L1.58446 10.6124C-0.528154 8.52779 -0.528154 5.14801 1.58446 3.06343C3.69708 0.978859 7.12233 0.978858 9.23495 3.06343L10 3.81832L10.765 3.06343Z"
        />
        <path
          class="wishlist-button__icon-solid"
          d="M10.765 3.06343C12.8777 0.978857 16.3029 0.978856 18.4155 3.06343C20.5282 5.148 20.5282 8.52779 18.4155 10.6124L10.72 18.2057C10.3224 18.5981 9.67763 18.5981 9.27996 18.2057L1.58446 10.6124C-0.528154 8.52779 -0.528154 5.14801 1.58446 3.06343C3.69708 0.978859 7.12233 0.978858 9.23495 3.06343L10 3.81832L10.765 3.06343Z"
        />
      </svg>
    </button>
  </wishlist-button>

  <script src="{{ 'wishlist-button.js' | asset_url }}" type="module"></script>
{% endif %}

{% stylesheet %}
  .wishlist-button {
    position: absolute;
    top: var(--badge-inset, var(--padding-xs));
    right: var(--badge-inset, var(--padding-xs));
    z-index: var(--layer-raised);
    opacity: 0;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .card-gallery:hover .wishlist-button,
  .wishlist-button:focus-within,
  .wishlist-button[data-active='true'] {
    opacity: 1;
  }

  /* Always visible on touch devices — there is no hover to reveal it */
  @media (hover: none), (pointer: coarse) {
    .wishlist-button {
      opacity: 1;
    }
  }

  .wishlist-button__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--style-border-radius-50);
    background: rgb(var(--color-background-rgb));
    box-shadow: var(--shadow-popover);
    cursor: pointer;
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .wishlist-button__toggle:hover {
    transform: scale(1.08);
  }

  .wishlist-button__icon {
    width: 18px;
    height: 18px;
    color: var(--color-foreground);
    fill: currentColor;
    transition: color var(--animation-speed) var(--animation-easing);
  }

  .wishlist-button__icon-solid {
    display: none;
  }

  .wishlist-button[data-active='true'] .wishlist-button__icon {
    color: var(--color-wishlist-active, #ff2d78);
    fill: var(--color-wishlist-active, #ff2d78);
  }

  .wishlist-button[data-active='true'] .wishlist-button__icon-outline {
    display: none;
  }

  .wishlist-button[data-active='true'] .wishlist-button__icon-solid {
    display: block;
  }
{% endstylesheet %}
